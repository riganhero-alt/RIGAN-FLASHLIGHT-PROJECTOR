<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rigan_bg_dark">
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:background="#9904060B">
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="BACK"
            android:textColor="@color/rigan_white"
            android:background="@drawable/bg_glass_card" />
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SELECT A VIDEO FROM GALLERY"
            android:textColor="@color/rigan_white"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/btnResetZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="RESET ZOOM"
            android:textColor="@color/rigan_electric_blue"
            android:background="@drawable/bg_glass_card" />
    </LinearLayout>
</FrameLayout>
